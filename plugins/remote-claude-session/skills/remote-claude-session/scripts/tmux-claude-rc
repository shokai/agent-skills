#!/usr/bin/env bash

set -e

if [ "$1" = -h ] || [ "$1" = --help ]; then
  cat <<'USAGE'
使い方:
  tmux-claude-rc <ディレクトリパス> [session名]      新規のtmux sessionを作り、そこでclaude --rcを起動する
  tmux-claude-rc -w <ディレクトリパス> <session名>   既存のtmux sessionにwindowとして足し、そこでclaude --rcを起動する

起動したremote sessionのURLを標準出力に出す。URLを30秒以内に取得できなかった時の終了コードは1。
USAGE
  exit 0
fi

window=
if [ "$1" = -w ]; then
  window=1
  shift
fi

# tmuxは-cに存在しないディレクトリを渡してもerrorにせず、別のディレクトリでshellを起動する
dir=$(cd "${1:-.}" && pwd)
name=$2

# session名が空だと、tmuxは-t "=:"を今のsessionに解決し、そこにwindowを足す
if [ -n "$window" ] && [ -z "$name" ]; then
  echo "-wにはsession名を指定する: tmux-claude-rc -w <ディレクトリパス> <session名>" >&2
  exit 1
fi

# tmuxは-sのsession名と-cのディレクトリをformatとして展開し、#(...)をshell commandとして実行するので、#を##にエスケープして文字として渡す
# -tのtargetは展開されないので、そのまま渡す
dir_literal=${dir//#/##}
name_literal=${name//#/##}

# claudeをsessionやwindowのコマンドにすると、claudeの終了と同時に閉じ、起動に失敗した時のerrorを読めない
if [ -n "$window" ]; then
  pane=$(tmux new-window -d -t "=$name:" -c "$dir_literal" -P -F '#{pane_id}') # =が無いと、tmuxはsession名を前方一致でも解決し、別のsessionにwindowを足す
else
  pane=$(tmux new-session -d -c "$dir_literal" ${name:+-s "$name_literal"} -P -F '#{pane_id}')
fi
tmux send-keys -t "$pane" 'claude --rc' Enter

# claudeはremote controlに接続すると、~/.claude/sessions/<pid>.jsonのbridgeSessionIdにremote sessionのIDを書く
shell_pid=$(tmux display-message -p -t "$pane" '#{pane_pid}')
url=
for _ in $(seq 60); do
  for pid in $(pgrep -P "$shell_pid" || true); do
    id=$(grep -o '"bridgeSessionId":"[^"]*"' ~/.claude/sessions/"$pid".json 2>/dev/null | cut -d'"' -f4)
    if [ -n "$id" ]; then
      url=https://claude.ai/code/$id
    fi
  done
  if [ -n "$url" ]; then
    break
  fi
  sleep 0.5
done
if [ -n "$url" ]; then
  echo "$url"
else
  echo "remote sessionのURLを30秒以内に取得できなかった。pane $pane の画面で原因を確かめる" >&2
fi

# 切り替える先のclientやterminalが無くても、paneは作れているので失敗にしない
tmux select-window -t "$pane" 2>/dev/null || true # switch-clientやattach-sessionがcurrent windowを変えても、そのsessionを表示している他のclientは再描画されない
if [ -n "$TMUX" ]; then
  tmux switch-client -t "$pane" 2>/dev/null || true
else
  tmux attach-session -t "$pane" 2>/dev/null || true
fi

# URLを取得できなかった事を、画面の切り替えの成否に関わらず終了コードで伝える
[ -n "$url" ]
